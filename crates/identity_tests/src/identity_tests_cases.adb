         and then Identity.Adapters.Keys.Admit_For_Verification
           (Key_Result, Identity.Crypto.Domains.API_Key)
           = Identity.Adapters.Keys.Allow_Verification
         and then Identity.Adapters.Keys.Admit_For_Creation
