      Assert
        (Identity.Adapters.Repositories.Memory.Append_Event (AT_Repo, AT_Event)
         = Identity.Adapters.Repositories.Memory.Uniqueness_Conflict
         and then Identity.Adapters.Repositories.Memory.Event_Count (AT_Repo)
