      Assert (Status = RT.Applied, "recovery-path: accept evidence applied");
      Identity.Adapters.Repositories.Stores.Find_Recovery_Transaction (SR, TX, Found, Rec);
      Assert (Rec.State = RT.Evidence_Accepted,
