      --  A failed recovery-code consume must not burn the code.
      Assert
        (Identity.Operations.Factors.Consume_Recovery_Code.Execute
           (AT_Repo, AT_CS1, AT_Absent_Code, Audit_Context, Next_Audit_Event, 1)
