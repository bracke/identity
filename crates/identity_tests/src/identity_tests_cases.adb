              = CP.Admitted,
              "compromise: with the check disabled, even a compromised password is admitted");
      Assert (CP.Admit (Check_Enabled => True, Verdict => CP.Compromised)
              = CP.Rejected_Compromised
              and then CP.Rejected_Password
