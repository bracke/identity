      Begin_At (MT ("12"));
      Assert (Resolve (MT ("12"), TR.Cancel_Transaction) = TR.Applied,
              "mfa-resolve: cancel applied");
      Identity.Adapters.Repositories.Stores.Find_Authentication_Transaction
