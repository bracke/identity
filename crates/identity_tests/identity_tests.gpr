with "config/identity_tests_config.gpr";

project Identity_Tests is
   for Source_Dirs use ("src", "config");
   for Main use ("identity_tests.adb", "identity_coverage.adb");
   for Object_Dir use "obj/" & Identity_Tests_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        Identity_Tests_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatwe", "-gnatyM120", "-gnatX");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Identity_Tests;
